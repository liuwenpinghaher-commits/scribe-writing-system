[Unit]
Description=Hermes gateway profile scribe3_deduce (API :8645)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/.hermes/profiles/scribe3_deduce
Environment=HOME=/home/ubuntu
Environment=HERMES_HOME=/home/ubuntu/.hermes/profiles/scribe3_deduce
Environment=VIRTUAL_ENV=/home/ubuntu/.hermes/hermes-agent/venv
Environment=PATH=/home/ubuntu/.hermes/hermes-agent/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=API_SERVER_PORT=8645
Environment=API_SERVER_HOST=127.0.0.1
ExecStart=/home/ubuntu/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main --profile scribe3_deduce gateway run --replace
Restart=always
RestartSec=5
TimeoutStopSec=240
StandardOutput=append:/opt/scribe3/logs/hermes-scribe3_deduce.log
StandardError=append:/opt/scribe3/logs/hermes-scribe3_deduce.err.log

[Install]
WantedBy=multi-user.target
