[Unit]
Description=Hermes gateway profile scribe3_plan (API :8647)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/scribe3-host/.hermes/profiles/scribe3_plan
Environment=HOME=/opt/scribe3-host
Environment=HERMES_HOME=/opt/scribe3-host/.hermes/profiles/scribe3_plan
Environment=VIRTUAL_ENV=/opt/scribe3-host/.hermes/hermes-agent/venv
Environment=PATH=/opt/scribe3-host/.hermes/hermes-agent/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=API_SERVER_PORT=8647
Environment=API_SERVER_HOST=172.18.0.1
ExecStart=/opt/scribe3-host/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main --profile scribe3_plan gateway run --replace
Restart=always
RestartSec=5
TimeoutStopSec=240
StandardOutput=append:/opt/scribe3/logs/hermes-scribe3_plan.log
StandardError=append:/opt/scribe3/logs/hermes-scribe3_plan.err.log

[Install]
WantedBy=multi-user.target
