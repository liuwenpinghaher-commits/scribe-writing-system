# 复制为 deploy/prod/.env（勿提交 git）
# cp deploy/prod/.env.example deploy/prod/.env

# 公网访问（域名 + 外层 nginx-ssl 反代 prod-frontend-1）
PUBLIC_HOST=www.qing.blue
# 前端容器宿主机映射：避免与外层 80/443 冲突
SCRIBE3_HTTP_BIND=127.0.0.1
SCRIBE3_HTTP_PORT=8088
VITE_API_BASE=/api
SCRIBE3_CORS_ORIGINS=https://www.qing.blue,https://qing.blue,http://127.0.0.1:8088

# 数据目录（宿主机）
SCRIBE3_DATA_DIR=/opt/scribe3/data
SCRIBE3_REPO_DIR=/opt/scribe3/app

# SurrealDB
SURREAL_USER=root
SURREAL_PASS=change-me-strong-pass

# L1 会话门禁（公网必开）— 见 docs/L1-AUTH-ISOLATION.md
SCRIBE3_AUTH_ENABLED=1
SCRIBE3_SESSION_SECRET=change-me-long-random-session-secret
SCRIBE3_BOOTSTRAP_USERS=admin:change-me-strong-password
SCRIBE3_LEGACY_OWNER=admin
SCRIBE3_SESSION_SECURE=1
# 可选机器 Bearer（非浏览器主路径）
# SCRIBE3_API_TOKEN=

# Hermes（容器 → 宿主机网关）
# Linux 生产：网关绑 Docker 网桥（compose 默认 bridge 网关常为 172.18.0.1），
# 并在 systemd 设 API_SERVER_HOST=172.18.0.1；勿用 127.0.0.1（容器不可达）。
# Docker Desktop 可用 host.docker.internal。
HERMES_API=http://172.18.0.1:8642/v1
HERMES_RESPONSES_API=http://172.18.0.1:8643/v1
HERMES_RUNS_API=http://172.18.0.1:8644/v1
HERMES_RESPONSES_PROFILE=scribe3
HERMES_RUNS_PROFILE=scribe3_write
# 从本机 ~/.hermes/.env 的 API_SERVER_KEY 拷过来
API_SERVER_KEY=

# 网关装好且 provision 后可改 1
SCRIBE3_STRICT_GATEWAY_GUARD=0

# embedding 模型缓存（容器挂载 /opt/scribe3/data/models/*）
# 服务器首次：bash deploy/prod/scripts/prefetch_embed_model.sh
HF_ENDPOINT=https://hf-mirror.com

# Git 部署
DEPLOY_BRANCH=main
GIT_REMOTE=origin

