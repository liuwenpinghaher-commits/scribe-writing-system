# =============================================================================
# 质量模式一键回滚片段 · 恢复 v6.3.3 类「可达」默认
# 口令：「恢复可达 = soft 旗开回 1」，不是「关 soft 旗」。
#
# 用法同 env.quality-mode.fragment：备份 .env → 合并本片段 → 重启 backend。
# =============================================================================

SCRIBE3_PILOT_SOFT_PRESSURE=1
SCRIBE3_PILOT_SOFT_AI_GRADE=1
SCRIBE3_BEATS_SYNOPSIS_FALLBACK=1
SCRIBE3_DRAMA_GATE=0
SCRIBE3_DRAMA_GATE_COMPAT=1
SCRIBE3_CRAFT_NOVEL=0
SCRIBE3_PARK_STROLL_BLOCKING=0
SCRIBE3_PDC_BLOCKING=0
# SCRIBE3_PDC=1 可保留（注入仍开、后验不 blocking）
# SCRIBE3_BEATS_V2=1 可保留（生成侧；与可达兼容）
# SCRIBE3_DRAMA_HARD_PRESSURE=4 默认不变
# 执行合同层回可达：关 steer/fulfill/drift/resteer
SCRIBE3_DEFAULT_DRAMA_STEER=0
SCRIBE3_SOFT_FULFILL=0
SCRIBE3_DRIVE_PROSE_DRIFT=0
SCRIBE3_SOFT_FULFILL_RESTEER=0
