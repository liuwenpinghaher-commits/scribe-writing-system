# =============================================================================
# 小说质量第一 · 质量模式 env 片段（PR-10 / Rollout Plan）
# 真源：docs/plans/2026-08-10-novel-quality-first-pipeline-optimization.md
#       scribe3/novel_quality_flags.py · QUALITY_MODE_TARGETS / EXTERNAL_ENV
#
# 用法（demo 机 · 勿提交密钥 · 改前备份）：
#   cd /opt/scribe3/app
#   cp -a deploy/prod/.env "deploy/prod/.env.bak.$(date +%Y%m%d-%H%M%S)"
#   # 将本文件中「KEY=value」行追加/合并进 deploy/prod/.env（勿重复键）
#   # 然后重启 backend，使进程读到新 env：
#   docker compose -f deploy/prod/docker-compose.yml --env-file deploy/prod/.env up -d backend
#   # 或：docker restart prod-backend-1
#
# 验收前请确认：代码已含 PR-0…8（含 117_beats_meta.surql），且 migration 已落库
# （见 docs/ops/nq-quality-mode-demo-runbook.md §migration）。
# =============================================================================

# --- 核心质量模式（用户 PR-10 清单 + 设计真值表）---
SCRIBE3_DRAMA_GATE=1
SCRIBE3_BEATS_SYNOPSIS_FALLBACK=0
SCRIBE3_CRAFT_NOVEL=1
SCRIBE3_PILOT_SOFT_PRESSURE=0
SCRIBE3_PILOT_SOFT_AI_GRADE=1
SCRIBE3_PARK_STROLL_BLOCKING=1
SCRIBE3_DRAMA_HARD_PRESSURE=4

# --- 设计 Rollout 完整质量模式（强烈推荐一并设置）---
SCRIBE3_BEATS_V2=1
SCRIBE3_DRAMA_GATE_COMPAT=0
SCRIBE3_PDC=1
SCRIBE3_PDC_BLOCKING=1
# SCRIBE3_PDC_GATE=1   # 可选；demo 片段未强制
