# 依赖与构建产物
**/.venv/
**/node_modules/
**/__pycache__/
**/dist/
**/build/
**/*.egg-info/
*.pyc

# 数据库与本地数据(绝不提交)
**/*.db
**/*.db-wal
**/*.db-shm

# 密钥与本地配置(绝不提交)
**/.env
**/.env.*
**/*.key
**/*.pem
secrets/
config.local.*

# 第三方 vendored 源码(本地从 GitHub 安装,自带 .git)
scribe/vendor/

# CodeGraph 索引(可重建)
**/.codegraph/

# 个性化训练产物(二进制,可重建)
scribe/out/

# 系统
.DS_Store
.superpowers/
.claude/worktrees/
.worktrees/

# e2e 数据快照(本机运行产物,可重建)
scribe3/web/e2e/.snapshots/

# PC UI 只读验收截图(pw_layout.mjs 运行产物,可重建)
scribe3/web/artifacts/

# 根级/会话 e2e 与运行产物(可重建,勿 git add .)
artifacts/
**/artifacts/

# 本地文档缓存与第三方解压参考树(可重建/非主线)
surrealdb-docs-cache/
oh-story-claudecode-main/
oh-story-claudecode-main.zip
Humanizer-zh-main.zip

# 编辑器/本机工具状态
.vscode/
.idea/
*.swp

# Python/测试缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 日志与临时
*.log
tmp/
.tmp/
history.txt

# split backups (local only)
**/*.monolith.bak


# production secrets on server / local
deploy/prod/.env

# keep env templates
!**/.env.example
!deploy/prod/.env.example
