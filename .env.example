# 铜炉写作系统 (Scribe Writing System / `scribe3`) 环境变量配置模板
# 复制本文件为 .env 并按需修改（.env 已被 .gitignore 忽略，切勿提交真实密钥）
# cp .env.example .env

# ==============================================================================
# 1. SurrealDB 3.x 存储层配置（一书一库，单真相源）
# ==============================================================================
SCRIBE3_SURREAL_URL=ws://127.0.0.1:8001/rpc
SCRIBE3_SURREAL_USER=root
SCRIBE3_SURREAL_PASS=root
SCRIBE3_SURREAL_NS=scribe3
# 默认当前作品库名（可在前端动态切换）
SCRIBE3_WORK=main
# SurrealDB 3.x CLI 可执行文件路径（供测试夹具或本地起服使用）
SURREAL_BIN=surreal

# ==============================================================================
# 2. 后端服务与隔离运行路径
# ==============================================================================
SCRIBE3_API_HOST=127.0.0.1
SCRIBE3_API_PORT=3321
SCRIBE3_WEB_PORT=3311
SCRIBE3_CORS_ORIGINS=http://127.0.0.1:3311,http://127.0.0.1:15173
# 本地设置台账与 LLM 消耗账本 SQLite 路径（E2E/测试时建议指向临时目录）
SCRIBE3_SETTINGS_DB=./tmp/scribe3_settings.sqlite3
SCRIBE3_LLM_LEDGER=./tmp/scribe3_llm_ledger.sqlite3

# ==============================================================================
# 3. LLM / Hermes Agent 网关与无商业 Key 降级配置
# ==============================================================================
# 主编对话与渲染网关（兼容 OpenAI /v1/chat/completions 与 Hermes Responses/Runs API）
HERMES_API=http://127.0.0.1:8642/v1
HERMES_RESPONSES_API=http://127.0.0.1:8643/v1
HERMES_RUNS_API=http://127.0.0.1:8644/v1
HERMES_DEDUCE_RUNS_API=http://127.0.0.1:8645/v1
HERMES_DEDUCE_PREVIEW_RUNS_API=http://127.0.0.1:8646/v1
HERMES_PLAN_RUNS_API=http://127.0.0.1:8647/v1
HERMES_DRAFT_RUNS_API=http://127.0.0.1:8648/v1
HERMES_RESPONSES_PROFILE=scribe3
HERMES_RUNS_PROFILE=scribe3_write
# 网关鉴权 Key（本地或 Mock 模式下可留空）
API_SERVER_KEY=
# 写作默认模型标识
SCRIBE3_DEFAULT_MODEL=qwen3.8-flash
# 是否开启网关严格守卫（0=允许离线/Mock降级启动，1=要求全部网关在线）
SCRIBE3_STRICT_GATEWAY_GUARD=0

# ==============================================================================
# 4. 工艺护栏、上下文预算与限知开关
# ==============================================================================
SCRIBE3_CONTEXT_SNAPSHOT_V1=1
SCRIBE3_MEMORY_FABRIC_V1=1
SCRIBE3_CONTEXT_INSPECTOR_V1=1
SCRIBE3_WORLD_SURFACE=on
# 紧急/测试 REST 世界写开关（生产默认 0 走 MCP 审批流；本地无网关演示/测试可设 1）
SCRIBE3_EMERGENCY_REST_WRITE=0

# ==============================================================================
# 5. 会话鉴权门禁（本地开发默认关闭，公网部署必开）
# ==============================================================================
SCRIBE3_AUTH_ENABLED=0
SCRIBE3_SESSION_SECRET=change-me-long-random-session-secret
SCRIBE3_BOOTSTRAP_USERS=admin:change-me-strong-password
SCRIBE3_LEGACY_OWNER=admin
