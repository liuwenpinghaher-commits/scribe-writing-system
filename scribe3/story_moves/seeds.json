    {
      "slug": "triangle_info",
      "name": "三角信息法",
      "one_liner": "本意别直说：假→破→真绕一圈。",
      "formula_family": "false_break_true",
      "formula": {
        "arrow": "假→破→真",
        "beats": [
          {"role": "假", "name": "反面", "hint": "先给期望、热闹、表面意义或暖物件"},
          {"role": "破", "name": "破功", "hint": "打碎、露怯、金包铜、底牌翻面"},
          {"role": "真", "name": "本意", "hint": "落到要表达的信息，不解说"}
        ]
      },
      "straight_line": "上来就写抠门/买不起/他其实很惨。",
      "aliases": [
        "欲扬先抑", "金锁三拍", "装逼打脸", "暗牌", "假意顺从",
        "打脸", "伪提示", "三层反差", "数字反差", "假胜", "高潮假胜"
      ],
      "benyi_aliases": ["穷", "拮据", "买不起", "惨", "孤独"],
      "usage": "同一招式必须换场面与物件；禁止模仿正例用词。无反转时不要硬塞。",
      "examples_pos": [
        {
          "benyi": "决裂",
          "beats": ["生日礼物很暖", "金锁其实是包铜", "丢进垃圾桶"]
        }
      ],
      "status": "approved",
      "origin": "seed"
    },
